{
  "cSpell.enabled": true,
  "cSpell.useGitignore": false,
  "cSpell.ignorePaths": [
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
